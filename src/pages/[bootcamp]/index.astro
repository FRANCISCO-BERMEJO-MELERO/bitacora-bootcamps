---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Card from '../../components/Card.astro';
import EstadoBootcamp from '../../components/EstadoBootcamp.astro';
import {
	agruparPorTema,
	formatearFecha,
	getApuntesDe,
	getBootcamps,
	isoFecha,
	plural,
	type Bootcamp,
} from '../../lib/apuntes';

export const getStaticPaths = (async () => {
	const bootcamps = await getBootcamps();
	return bootcamps.map((bootcamp) => ({ params: { bootcamp: bootcamp.id }, props: { bootcamp } }));
}) satisfies GetStaticPaths;

interface Props {
	bootcamp: Bootcamp;
}

const { bootcamp } = Astro.props;
const { nombre, plataforma, url, estado, color, inicio } = bootcamp.data;
const apuntes = await getApuntesDe(bootcamp.id);
const temas = agruparPorTema(apuntes);
---

<Base titulo={nombre} descripcion={`Apuntes del ${nombre} de ${plataforma}.`} acento={color}>
	<Breadcrumbs migas={[{ texto: 'Bitácora', href: '/' }, { texto: nombre }]} />

	<header class="cabecera relative mt-8 pl-6 sm:pl-8">
		<h1 class="text-4xl leading-[0.95] font-black tracking-[-0.03em] text-balance sm:text-6xl">
			{nombre}
		</h1>
		<p class="mt-3 text-lg text-ink-soft">{plataforma}</p>
		<div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
			<EstadoBootcamp estado={estado} />
			{
				inicio && (
					<span class="text-ink-soft">
						Empezado el <time datetime={isoFecha(inicio)}>{formatearFecha(inicio)}</time>
					</span>
				)
			}
			<span class="cifras text-ink-soft">
				{plural(apuntes.length, 'apunte')} en {plural(temas.length, 'tema')}
			</span>
			{
				url && (
					<a href={url} class="enlace font-semibold text-accent-ink" target="_blank" rel="noopener noreferrer">
						Web del curso<span class="sr-only"> (se abre en otra pestaña)</span>
					</a>
				)
			}
		</div>
	</header>

	{
		temas.length === 0 ? (
			<p class="mt-14 max-w-prose text-ink-soft">
				Este bootcamp aún no tiene apuntes. Añade el primero en{' '}
				<code class="text-ink">src/content/apuntes/{bootcamp.id}/&lt;tema&gt;/01-&lt;titulo&gt;.md</code>.
			</p>
		) : (
			<div class="mt-14 lg:grid lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-12">
				<nav aria-label="Temas" class="hidden lg:block">
					<div class="sticky top-6">
						<p class="mb-3 text-sm font-bold">Temas</p>
						<ol class="space-y-1 border-l border-rule text-sm">
							{temas.map((tema) => (
								<li>
									<a
										href={`#${tema.slug}`}
										class="-ml-px flex justify-between gap-3 border-l-2 border-transparent py-1 pl-4 text-ink-soft transition-colors hover:border-accent hover:text-ink"
									>
										<span>{tema.nombre}</span>
										<span class="cifras text-ink-soft">{tema.apuntes.length}</span>
									</a>
								</li>
							))}
						</ol>
					</div>
				</nav>

				<div class="space-y-14">
					{temas.map((tema) => (
						<section aria-labelledby={tema.slug} class="scroll-mt-6">
							<div class="flex items-baseline justify-between gap-4 border-b border-ink/80 pb-2">
								<h2 id={tema.slug} class="scroll-mt-6 text-2xl font-extrabold tracking-tight text-balance">
									{tema.nombre}
								</h2>
								<span class="cifras shrink-0 text-sm text-ink-soft">
									{plural(tema.apuntes.length, 'apunte')}
								</span>
							</div>
							<ol class="mt-5 space-y-4">
								{tema.apuntes.map((apunte) => (
									<li>
										<Card apunte={apunte} />
									</li>
								))}
							</ol>
						</section>
					))}
				</div>
			</div>
		)
	}
</Base>

<style>
	.cabecera::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.35rem;
		bottom: 0.2rem;
		width: 8px;
		border-radius: 2px;
		background: var(--accent);
	}
</style>
